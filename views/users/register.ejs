
<% layout('layouts/boilerplate') %>

<link rel="stylesheet" href="/stylesheets/auth.css">

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-image">
            <img
                src="https://images.unsplash.com/photo-1508873696983-2dfd5898f08b?q=80&w=2070&auto=format&fit=crop"
                alt="A peaceful campsite surrounded by nature"
            >
            <div class="auth-image-overlay">
                <span class="auth-eyebrow">YOUR NEXT ADVENTURE</span>
                <h2>Find your place<br>in the wild.</h2>
            </div>
        </div>

        <div class="auth-content">
            <span class="auth-eyebrow">CAMPNAVI</span>
            <h1>Join CampNavi</h1>
            <p class="auth-subtitle">Create an account and start discovering your next outdoor escape.</p>

            <form action="/register" method="POST" class="validated-form" novalidate>
                <div class="auth-form-group">
                    <label for="username">Username</label>
                    <input
                        class="form-control"
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Choose a username"
                        autofocus
                        required
                    >
                    <div class="invalid-feedback">Please enter a username.</div>
                </div>

                <div class="auth-form-group">
                    <label for="email">Email</label>
                    <input
                        class="form-control"
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email address"
                        required
                    >
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>

                <div class="auth-form-group">
                    <label for="password">Password</label>
                    <input
                        class="form-control"
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create a password"
                        required
                    >
                    <div class="invalid-feedback">Please enter a password.</div>
                </div>

                <button class="auth-submit" type="submit">
                    Create account
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <p class="auth-switch">
                Already have an account?
                <a href="/login">Log in</a>
            </p>
        </div>
    </div>
</div>
