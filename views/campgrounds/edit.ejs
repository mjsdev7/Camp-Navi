
<% layout('layouts/boilerplate') %>

<div class="form-page">
    <div class="form-container">

        <div class="form-heading">
            <p class="form-eyebrow">UPDATE YOUR LISTING</p>
            <h1>Edit <em>Campground.</em></h1>
            <p>Make changes to your destination and keep your listing up to date.</p>
        </div>

        <div class="camp-form-card">

            <form action="/campgrounds/<%= campground._id %>?_method=PUT"
                method="POST"
                novalidate
                class="validated-form"
                enctype="multipart/form-data">

                <div class="form-field">
                    <label for="title">Campground name</label>
                    <input
                        class="form-control"
                        type="text"
                        id="title"
                        name="campground[title]"
                        value="<%= campground.title %>"
                        placeholder="Enter campground name"
                        required>
                    <div class="invalid-feedback">Title is required.</div>
                </div>

                <div class="form-field">
                    <label for="location">Location</label>
                    <input
                        class="form-control"
                        type="text"
                        id="location"
                        name="campground[location]"
                        value="<%= campground.location %>"
                        placeholder="Where is it located?"
                        required>
                    <div class="invalid-feedback">Location is required.</div>
                </div>

                <div class="form-field">
                    <label for="price">Price per night</label>
                    <div class="input-group">
                        <span class="input-group-text">¥</span>
                        <input
                            class="form-control"
                            type="number"
                            id="price"
                            name="campground[price]"
                            value="<%= campground.price %>"
                            min="0"
                            placeholder="0"
                            required>
                    </div>
                    <div class="invalid-feedback">Please enter a valid price.</div>
                </div>

                <div class="form-field">
                    <label for="description">Description</label>
                    <textarea
                        class="form-control"
                        id="description"
                        name="campground[description]"
                        rows="6"
                        placeholder="Describe the campground..."
                        required><%= campground.description %></textarea>
                    <div class="invalid-feedback">Description is required.</div>
                </div>

                <div class="form-field">
                    <label for="images">Add more images</label>
                    <input
                        type="file"
                        class="form-control"
                        name="image[]"
                        id="images"
                        accept="image/*"
                        multiple>
                    <p class="form-help">You can upload additional photos to your listing.</p>
                </div>

                <% if (campground.images && campground.images.length > 0) { %>
                    <div class="form-field">
                        <label>Current images</label>
                        <p class="form-help">Select the images you want to remove.</p>

                        <div class="edit-image-grid">
                            <% campground.images.forEach(function(img, i) { %>
                                <div class="edit-image-item">
                                    <img src="<%= img.thumbnail %>" alt="Current campground image">

                                    <label class="delete-image-option" for="image-<%= i %>">
                                        <input
                                            type="checkbox"
                                            id="image-<%= i %>"
                                            name="deleteImages[]"
                                            value="<%= img.filename %>">
                                        <span>Delete image</span>
                                    </label>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <div class="form-actions">
                    <button type="submit" class="form-submit-button">
                        Save changes <span>↗</span>
                    </button>

                    <a href="/campgrounds/<%= campground._id %>" class="form-cancel-link">
                        Cancel
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>
