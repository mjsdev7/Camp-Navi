
<% layout('layouts/boilerplate') %>

<link rel="stylesheet" href="/stylesheets/camp-form.css">

<div class="camp-form-page">
    <div class="camp-form-heading">
        <span class="camp-form-eyebrow">SHARE YOUR DISCOVERY</span>
        <h1>Add a campground</h1>
        <p>Help others discover their next favourite place in the outdoors.</p>
    </div>

    <div class="camp-form-card">
        <form
            action="/campgrounds"
            method="POST"
            novalidate
            class="validated-form"
            enctype="multipart/form-data"
        >
            <div class="camp-form-group">
                <label for="title">Campground name</label>
                <input
                    class="form-control"
                    type="text"
                    id="title"
                    name="campground[title]"
                    placeholder="e.g. Forest Valley Retreat"
                    required
                >
                <div class="invalid-feedback">Please enter a campground name.</div>
            </div>

            <div class="camp-form-group">
                <label for="location">Location</label>
                <input
                    class="form-control"
                    type="text"
                    id="location"
                    name="campground[location]"
                    placeholder="e.g. Nagano, Japan"
                    required
                >
                <div class="invalid-feedback">Please enter a location.</div>
            </div>

            <div class="camp-form-group">
                <label for="images">Campground photos</label>
                <input
                    type="file"
                    class="form-control"
                    name="image"
                    id="images"
                    accept="image/*"
                    multiple
                >
                <small class="camp-form-hint">Add photos to show visitors what makes this place special.</small>
            </div>

            <div class="camp-form-group">
                <label for="price">Price per night</label>
                <div class="input-group">
                    <span class="input-group-text" id="price-label">¥</span>
                    <input
                        type="text"
                        class="form-control"
                        id="price"
                        name="campground[price]"
                        placeholder="0"
                        aria-describedby="price-label"
                        required
                    >
                    <div class="invalid-feedback">Please enter a price.</div>
                </div>
            </div>

            <div class="camp-form-group">
                <label for="description">Description</label>
                <textarea
                    class="form-control"
                    id="description"
                    name="campground[description]"
                    rows="6"
                    placeholder="Describe the surroundings, facilities and what visitors can expect..."
                    required
                ></textarea>
                <div class="invalid-feedback">Please add a description.</div>
            </div>

            <div class="camp-form-actions">
                <button type="submit" class="camp-form-submit">
                    Add campground
                    <span aria-hidden="true">→</span>
                </button>
                <a href="/campgrounds" class="camp-form-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>
