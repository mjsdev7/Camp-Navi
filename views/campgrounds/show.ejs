
<% layout('layouts/boilerplate') %>

<link rel="stylesheet" href="/stylesheets/stars.css">
<link rel="stylesheet" href="/stylesheets/show.css">

<main class="show-page">

    <div class="show-breadcrumb">
        <a href="/campgrounds">Explore campgrounds</a>
        <span>/</span>
        <span><%= campground.title %></span>
    </div>

    <section class="show-header">
        <div>
            <p class="show-eyebrow">YOUR NEXT OUTDOOR ESCAPE</p>
            <h1><%= campground.title %></h1>
            <p class="show-location">
                <span class="location-dot"></span>
                <%= campground.location %>
            </p>
        </div>

        <div class="show-price">
            <span class="price-label">FROM</span>
            <strong>¥<%= campground.price.toLocaleString('ja-JP') %></strong>
            <span class="price-unit">per night</span>
        </div>
    </section>

    <section class="show-gallery">
        <% if (campground.images && campground.images.length > 0) { %>
            <div id="campgroundCarousel" class="carousel slide" data-bs-ride="carousel">

                <div class="carousel-inner">
                    <% campground.images.forEach((img, i) => { %>
                        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                            <img
                                src="<%= img.url %>"
                                class="d-block w-100 campground-image"
                                alt="<%= campground.title %>"
                            >
                        </div>
                    <% }) %>
                </div>

                <% if (campground.images.length > 1) { %>
                    <button
                        class="carousel-control-prev"
                        type="button"
                        data-bs-target="#campgroundCarousel"
                        data-bs-slide="prev"
                        aria-label="Previous image"
                    >
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button
                        class="carousel-control-next"
                        type="button"
                        data-bs-target="#campgroundCarousel"
                        data-bs-slide="next"
                        aria-label="Next image"
                    >
                        <span class="carousel-control-next-icon"></span>
                    </button>

                    <div class="gallery-count">
                        <span id="galleryCurrent">1</span> / <%= campground.images.length %>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="gallery-empty">
                <span>No images available</span>
            </div>
        <% } %>
    </section>

    <div class="show-content-grid">

        <div class="show-main-column">

            <section class="show-section about-section">
                <p class="show-eyebrow">ABOUT THIS CAMPSITE</p>
                <h2>Find your place in nature.</h2>
                <p class="show-description"><%= campground.description %></p>
            </section>

            <section class="show-section location-section">
                <p class="show-eyebrow">FIND YOUR WAY</p>
                <h2>Location</h2>
                <p class="location-description"><%= campground.location %></p>
                <div id="cluster-map" class="show-map"></div>
            </section>

            <section class="show-section reviews-section">
                <div class="section-heading">
                    <div>
                        <p class="show-eyebrow">GUEST EXPERIENCES</p>
                        <h2>What visitors say</h2>
                    </div>
                    <span class="review-count">
                        <%= campground.reviews.length %>
                        <%= campground.reviews.length === 1 ? 'review' : 'reviews' %>
                    </span>
                </div>

                <% if (currentUser) { %>
                    <div class="review-form-card">
                        <h3>Share your experience</h3>
                        <p>How was your stay?</p>

                        <form
                            action="/campgrounds/<%= campground._id %>/reviews"
                            method="POST"
                            class="validated-form"
                            novalidate
                        >
                            <div class="mb-3">
                                <fieldset class="starability-growRotate">
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" checked />
                                    <label for="first-rate1">1 star</label>

                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2">2 stars</label>

                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3">3 stars</label>

                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4">4 stars</label>

                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5">5 stars</label>
                                </fieldset>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="body">Your review</label>
                                <textarea
                                    class="form-control"
                                    id="body"
                                    name="review[body]"
                                    rows="4"
                                    placeholder="Tell others about your experience..."
                                    required
                                ></textarea>
                                <div class="invalid-feedback">
                                    Please write a review before submitting.
                                </div>
                            </div>

                            <button class="show-button" type="submit">Submit review</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="review-login-prompt">
                        <p>Stayed here? We'd love to hear what you thought.</p>
                        <a href="/login">Log in to leave a review</a>
                    </div>
                <% } %>

                <% if (campground.reviews.length > 0) { %>
                    <div class="review-list">
                        <% for (let review of campground.reviews) { %>
                            <article class="review-card">
                                <div class="review-card-top">
                                    <div>
                                        <h3><%= review.author ? review.author.username : 'Unknown' %></h3>
                                        <p class="review-guest">Camp Navi visitor</p>
                                    </div>

                                    <p class="starability-result" data-rating="<%= review.rating %>">
                                        Rated: <%= review.rating %> stars
                                    </p>
                                </div>

                                <p class="review-body"><%= review.body %></p>

                                <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                                    <form
                                        action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST"
                                        class="review-delete-form"
                                    >
                                        <button type="submit" class="review-delete-button">
                                            Delete review
                                        </button>
                                    </form>
                                <% } %>
                            </article>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="no-reviews">
                        <p>No reviews yet. Be the first to share your experience.</p>
                    </div>
                <% } %>
            </section>

        </div>

        <aside class="show-sidebar">

            <div class="booking-card">
                <p class="show-eyebrow">PLAN YOUR STAY</p>
                <h2>Make time for the outdoors.</h2>

                <div class="booking-price">
                    <strong>¥<%= campground.price.toLocaleString('ja-JP') %></strong>
                    <span>/ night</span>
                </div>

                <a href="/campgrounds" class="show-button booking-button">
                    Explore more campsites
                </a>

                <p class="booking-note">Discover more places to escape and unwind.</p>
            </div>

            <div class="host-card">
                <p class="show-eyebrow">CAMPGROUND LISTED BY</p>
                <h3><%= campground.author ? campground.author.username : 'Unknown' %></h3>
                <p>Shared with the Camp Navi community.</p>
            </div>

            <% if (currentUser && campground.author && campground.author.equals(currentUser._id)) { %>
                <div class="owner-card">
                    <p class="show-eyebrow">MANAGE LISTING</p>
                    <h3>Your campground</h3>

                    <a
                        class="show-button owner-edit-button"
                        href="/campgrounds/<%= campground._id %>/edit"
                    >
                        Edit listing
                    </a>

                    <form
                        action="/campgrounds/<%= campground._id %>?_method=DELETE"
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this campground?');"
                    >
                        <button type="submit" class="owner-delete-button">
                            Delete campground
                        </button>
                    </form>
                </div>
            <% } %>

        </aside>
    </div>

    <div class="show-back-link">
        <a href="/campgrounds">← Back to all campgrounds</a>
    </div>

</main>

<script>
    window.maptilerApiKey = '<%= maptilerApiKey %>';
</script>

<script id="campground-data" type="application/json">
    <%- JSON.stringify(campground) %>
</script>

<script src="/javascripts/showPageMap.js"></script>

<script>
    const campgroundCarousel = document.getElementById('campgroundCarousel');
    const galleryCurrent = document.getElementById('galleryCurrent');

    if (campgroundCarousel && galleryCurrent) {
        campgroundCarousel.addEventListener('slid.bs.carousel', function (event) {
            galleryCurrent.textContent = event.to + 1;
        });
    }
</script>
