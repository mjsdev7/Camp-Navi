
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Camp Navi — Find Your Place in the Wild</title>

    <meta name="description"
        content="Discover Japan's beautiful campsites. Find your next outdoor adventure with Camp Navi.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/home.css">
</head>

<body>

    <!-- HERO -->
    <div class="hero">

        <header class="site-header">
            <a href="/" class="brand">camp<span>navi.</span></a>

            <nav class="main-nav">
                <a href="/" class="nav-link active">Home</a>
                <a href="/campgrounds" class="nav-link">Explore</a>

                <% if (!currentUser) { %>
                    <a href="/login" class="nav-link">Login</a>
                    <a href="/register" class="nav-cta">
                        Join Camp Navi <span>↗</span>
                    </a>
                <% } else { %>
                    <a href="/logout" class="nav-link">Logout</a>
                <% } %>
            </nav>

            <button class="menu-toggle"
                aria-label="Toggle navigation"
                aria-expanded="false">
                <span></span>
                <span></span>
            </button>
        </header>

        <main class="hero-content">
            <p class="eyebrow">
                <span></span> YOUR NEXT ADVENTURE STARTS HERE
            </p>

            <h1>
                Find your place<br>
                in the <em>wild.</em>
            </h1>

            <p class="hero-description">
                From quiet forest hideaways to lakeside views beneath Mount Fuji.
                Discover the beauty of camping in Japan.
            </p>

            <a href="/campgrounds" class="explore-button">
                <span>Explore campgrounds</span>
                <span class="button-arrow">↗</span>
            </a>

            <div class="hero-location">
                <span class="location-line"></span>
                <span>DISCOVER THE OUTDOORS · JAPAN</span>
            </div>
        </main>

        <div class="hero-bottom">
            <span class="scroll-label">SCROLL TO EXPLORE</span>
            <span class="scroll-line"></span>
        </div>

    </div>


    <!-- FEATURED CAMPGROUNDS -->
    <section class="featured-section">
        <div class="featured-container">

            <div class="section-heading">
                <div>
                    <p class="section-eyebrow">FIND YOUR NEXT ESCAPE</p>
                    <h2>Places worth <em>discovering.</em></h2>
                </div>

                <a href="/campgrounds" class="view-all-link">
                    View all campgrounds <span>↗</span>
                </a>
            </div>

            <% if (featuredCampgrounds && featuredCampgrounds.length > 0) { %>

                <div class="featured-grid">
                    <% featuredCampgrounds.forEach(campground => { %>

                        <a href="/campgrounds/<%= campground._id %>"
                            class="featured-card">

                            <div class="featured-image">
                                <% if (campground.images && campground.images.length > 0) { %>
                                    <img
                                        src="<%= campground.images[0].url %>"
                                        alt="<%= campground.title %>"
                                        loading="lazy">
                                <% } else { %>
                                    <div class="featured-image-placeholder">
                                        <span>Camp Navi</span>
                                    </div>
                                <% } %>
                            </div>

                            <div class="featured-card-content">
                                <p class="featured-location">
                                    <%= campground.location %>
                                </p>

                                <h3><%= campground.title %></h3>

                                <span class="featured-card-link">
                                    Discover campground ↗
                                </span>
                            </div>
                        </a>

                    <% }) %>
                </div>

            <% } else { %>

                <p class="featured-empty">
                    New camping destinations are coming soon.
                </p>

            <% } %>

        </div>
    </section>


    <!-- WHY CAMP NAVI -->
    <section class="why-section">
        <div class="why-container">

            <div class="why-intro">
                <p class="section-eyebrow">THE CAMP NAVI EXPERIENCE</p>

                <h2>
                    More than a place<br>
                    to <em>pitch your tent.</em>
                </h2>

                <p>
                    Great outdoor experiences start with finding the right place.
                    We're here to make discovering your next escape a little easier.
                </p>
            </div>

            <div class="features-grid">

                <article class="feature-item">
                    <span class="feature-number">01</span>
                    <div class="feature-icon">⌖</div>
                    <h3>Discover places</h3>
                    <p>
                        Explore camping destinations and find somewhere new
                        to escape the everyday.
                    </p>
                </article>

                <article class="feature-item">
                    <span class="feature-number">02</span>
                    <div class="feature-icon">✳</div>
                    <h3>Find inspiration</h3>
                    <p>
                        Browse unique outdoor locations and get inspired
                        for your next adventure.
                    </p>
                </article>

                <article class="feature-item">
                    <span class="feature-number">03</span>
                    <div class="feature-icon">♡</div>
                    <h3>Share experiences</h3>
                    <p>
                        Read reviews and discover what other campers
                        love about their favourite places.
                    </p>
                </article>

            </div>
        </div>
    </section>


    <!-- DISCOVER JAPAN -->
    <section class="discover-section">

        <div class="discover-heading">
            <div>
                <p class="section-eyebrow">A WORLD OUTSIDE</p>
                <h2>Discover the beauty of <em>Japan.</em></h2>
            </div>

            <p>
                From mountain landscapes to peaceful woodland retreats,
                adventure is never too far away.
            </p>
        </div>

        <div class="discover-grid">

            <a href="/campgrounds" class="discover-card discover-fuji">
                <div class="discover-overlay"></div>
                <div class="discover-content">
                    <span>01 / MOUNTAIN ESCAPES</span>
                    <h3>Under the shadow<br>of Fuji.</h3>
                    <span class="discover-link">Explore campgrounds ↗</span>
                </div>
            </a>

            <a href="/campgrounds" class="discover-card discover-forest">
                <div class="discover-overlay"></div>
                <div class="discover-content">
                    <span>02 / WOODLAND RETREATS</span>
                    <h3>Find your<br>quiet place.</h3>
                    <span class="discover-link">Explore campgrounds ↗</span>
                </div>
            </a>

            <a href="/campgrounds" class="discover-card discover-lake">
                <div class="discover-overlay"></div>
                <div class="discover-content">
                    <span>03 / LAKESIDE GETAWAYS</span>
                    <h3>Closer to<br>nature.</h3>
                    <span class="discover-link">Explore campgrounds ↗</span>
                </div>
            </a>

        </div>
    </section>


    <!-- FINAL CALL TO ACTION -->
    <section class="closing-section">
        <div class="closing-content">
            <p class="section-eyebrow">YOUR NEXT ESCAPE AWAITS</p>

            <h2>
                The outdoors<br>
                is calling <em>you.</em>
            </h2>

            <p>
                Take a break from the everyday.
                Find somewhere new and make your next adventure count.
            </p>

            <a href="/campgrounds" class="closing-button">
                Find your campground <span>↗</span>
            </a>
        </div>
    </section>


    <!-- FOOTER -->
    <footer class="site-footer">

        <div class="footer-main">

            <div class="footer-brand">
                <a href="/" class="brand">camp<span>navi.</span></a>
                <p>Find your place in the wild.</p>
            </div>

            <div class="footer-column">
                <h4>Explore</h4>
                <a href="/campgrounds">Campgrounds</a>
                <a href="/campgrounds">Discover Japan</a>
            </div>

            <div class="footer-column">
                <h4>Your account</h4>
                <% if (!currentUser) { %>
                    <a href="/login">Login</a>
                    <a href="/register">Create account</a>
                <% } else { %>
                    <a href="/logout">Logout</a>
                <% } %>
            </div>

        </div>

        <div class="footer-bottom">
            <span>© <%= new Date().getFullYear() %> Camp Navi. All rights reserved.</span>
            <a href="/">Made for the love of the outdoors.</a>
        </div>

    </footer>


    <!-- MOBILE NAVIGATION -->
    <script>
        const menuToggle = document.querySelector('.menu-toggle');
        const navigation = document.querySelector('.main-nav');

        menuToggle.addEventListener('click', () => {
            const isOpen = navigation.classList.toggle('nav-open');

            menuToggle.classList.toggle('menu-open', isOpen);
            menuToggle.setAttribute('aria-expanded', isOpen);
        });

        navigation.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                navigation.classList.remove('nav-open');
                menuToggle.classList.remove('menu-open');
                menuToggle.setAttribute('aria-expanded', 'false');
            });
        });
    </script>

</body>
</html>
